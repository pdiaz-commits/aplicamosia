[Unit]
Description=AplicamosIA Django (Gunicorn)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/aplicamosia.es
EnvironmentFile=/var/www/aplicamosia.es/.env
ExecStart=/var/www/aplicamosia.es/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8027 \
    --workers 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
